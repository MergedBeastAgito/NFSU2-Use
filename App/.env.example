# Cloudflare credentials for the driver. Copy to `.env` and fill in; `.env` is
# ignored, this file is not, so the names travel and the values do not.
#
# The driver reads the process environment first, then the file named by
# CLOUDFLARE_ENV_FILE. Neither value has a default: a missing account id is
# `no account id` and a missing token is `no token`, and the tick carries on.

CLOUDFLARE_API_TOKEN=

CLOUDFLARE_ACCOUNT_ID=

# Optional. A dotenv file to read CLOUDFLARE_API_TOKEN from when it is not
# exported, e.g. /path/to/.env.
CLOUDFLARE_ENV_FILE=
