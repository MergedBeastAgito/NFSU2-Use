# Cloudflare credentials for the driver. Copy to `.env` and fill in; `.env` is
# ignored, this file is not, so the names travel and the values do not.
#
# The driver reads the process environment first, then a dotenv file: this one
# (`App/.env`) when it exists, the file named by CLOUDFLARE_ENV_FILE when that
# is set, and /usr/local/etc/nfsu2/.env as the last resort. Neither value has a
# default: a missing account id is `no account id` and a missing token is
# `no token`, and the tick carries on.

CLOUDFLARE_API_TOKEN=

CLOUDFLARE_ACCOUNT_ID=

# Optional. Another dotenv file to read CLOUDFLARE_API_TOKEN from when it is
# not exported. Relative paths are read from the crate, so `../.env` and
# `App/.env` name the same file.
CLOUDFLARE_ENV_FILE=
